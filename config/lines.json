  "shared_pipeline": {
    "restock_daemon": {
      "script": "restock_daemon.py",
      "interval_min": 20,
      "writes": "restock-daemon.json"
    },
    "restock_once": {
      "script": "restock.py",
      "writes": "farmsync-*.json"
    },
    "pool_refresh": {
      "script": "pool-refresh.py",
      "via": "pool-refresh.cmd",
      "task": "FreeLLMAPI-PoolRefresh",
      "interval_min": 2,
      "writes": "pool-history.json"
    },
