      "script": "checkin_daemon.py",
      "status": "已被 2号/6号签到守护替代，当前无进程"
    },
    "scheduler_suspect": {
      "script": "ai4-统一调度器.py",
      "status": "无计划任务引用，用途待确认"
    }
  },
  "state_files": [
    {
      "path": "restock-daemon.json",
      "max_age_min": 60,
      "desc": "restock 守护每轮结果"
    },
    {
      "path": "pool-history.json",
      "max_age_min": 10,
